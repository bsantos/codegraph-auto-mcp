{
  "name": "codegraph-mcp",
  "displayName": "CodeGraph MCP",
  "description": "Auto-registers CodeGraph MCP server for GitHub Copilot, with project init & re-index support",
  "version": "1.0.3",
  "icon": "images/logo.png",
  "publisher": "bsantos",
  "license": "MIT",
  "engines": {
    "vscode": "^1.106.0"
  },
  "categories": [
    "AI"
  ],
  "keywords": [
    "copilot",
    "mcp",
    "code intelligence",
    "code graph",
    "ast",
    "codebase understanding",
    "model context protocol"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/bsantos/codegraph-auto-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/bsantos/codegraph-auto-mcp/issues"
  },
  "homepage": "https://github.com/bsantos/codegraph-auto-mcp#readme",
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "codegraph.restart",
        "title": "CodeGraph: Restart MCP Server"
      },
      {
        "command": "codegraph.initProject",
        "title": "CodeGraph: Initialize Project"
      },
      {
        "command": "codegraph.sync",
        "title": "CodeGraph: Force Re-index"
      },
      {
        "command": "codegraph.installCli",
        "title": "CodeGraph: Install CLI v1.5.0 (Recommended)"
      },
      {
        "command": "codegraph.showMenu",
        "title": "CodeGraph: Show Menu"
      }
    ],
    "mcpServerDefinitionProviders": [
      {
        "id": "codegraph",
        "label": "CodeGraph"
      }
    ],
    "configuration": {
      "title": "CodeGraph",
      "properties": {
        "codegraph.path": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "Manually specify the full path to the codegraph CLI. Leave empty to auto-detect.\n\nIf set and executable, the automatic lookup is skipped."
        }
      }
    }
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "CodeGraph runs the codegraph CLI against the workspace contents."
    }
  },
  "scripts": {
    "compile": "npm run check && npm run build",
    "build": "esbuild src/extension.ts --bundle --minify --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --target=node18",
    "watch": "esbuild src/extension.ts --bundle --sourcemap --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --target=node18 --watch",
    "check": "tsc --noEmit",
    "compile-tests": "tsc -p .",
    "pretest": "npm run compile-tests && npm run build",
    "test": "vscode-test",
    "vscode:prepublish": "npm run build",
    "package": "vsce package --no-dependencies",
    "release": "standard-version",
    "publish": "npm run release && vsce publish --no-dependencies"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.106.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.25.0",
    "standard-version": "^9.5.0",
    "typescript": "^5.9.3"
  }
}
